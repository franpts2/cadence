# Google OAuth — the only sign-in method.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Spotify app credentials — used for the app-only (Client Credentials) token
# that powers song search. No Spotify login, redirect URI, or user scopes.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

AUTH_SECRET=your_auth_secret_generate_with_openssl_rand_base64_32
TURSO_DATABASE_URL=your_turso_db_url
TURSO_AUTH_TOKEN=your_turso_auth_token
AUTH_TRUST_HOST=true
